/ DUMP8.PA
/ Dump a range of core as octal words, eight per line, using PUTC.
/ You can adapt the inner loop to pull words from a DECtape buffer instead.

        / Zero page / working storage
        *0020
PTR,    0       / current word address
WCOUNT, 0       / words printed on current line (0..7)
WORD,   0       / scratch for current word
DIGCNT, 0       / digit counter in OCT4
TMP,    0       / scratch
WA,     0       / start address
WB,     0177    / end address
        *0200   / back to code

START,  CLA CLL
        TAD     WA      / PTR := WA
        DCA     PTR

LOOP,   TAD     PTR
        CMA IAC              / AC := -PTR
        TAD     WB
        SMA                  / if END - PTR < 0, we're past the end
        JMP     OVER
        JMP     DONE

OVER,   JMS     PRLINE
        JMP     LOOP
DONE,   HLT

PRLINE, 0
        JMS PRADDR
        CLA
        TAD MINUS8
        DCA WCOUNT              / words remain

LLOOP,  JMS PRWORD
        CLA CLL IAC
        TAD PTR
        DCA PTR
        ISZ WCOUNT
        JMP     LLOOP
        JMP     EOL

EOL,    CLA
        TAD     CR
        JMS     PUTC
        CLA
        TAD     LF
        JMS     PUTC
        JMP I PRLINE

PRADDR, 0
        CLA
        TAD PTR
        JMS OCT4
        CLA
        TAD COLON
        JMS PUTC
        CLA
        TAD SPACE
        JMS PUTC
        JMP I PRADDR

PRWORD, 0
        CLA
        TAD I PTR
        JMS OCT4
        CLA
        TAD SPACE
        JMS PUTC
        JMP I PRWORD

COLON,  ":"

PUTC,   0
        IOT     6021        / PSF: skip if paper-tape punch ready
        JMP     .-1
        IOT     6026        / PPC: punch AC low 6 bits
        CLL CLA
        JMP I   PUTC
        7777                    / marker

/ OCT4: print WORD as four octal digits (0000–7777), most-significant first.
/   Uses WORD, DIGCNT, TMP, calls PUTC.
/   On entry: WORD holds the 12-bit value to print.

OCT4,   0
        DCA W
        TAD W
        BSW
        RAR; RAR; RAR
        AND SEVEN
        TAD ZEROCH
        JMS PUTC
        TAD W
        BSW
        AND SEVEN
        TAD ZEROCH
        JMS PUTC
        TAD W
        RAR; RAR; RAR
        AND SEVEN
        TAD ZEROCH
        JMS PUTC
        TAD W
        AND SEVEN
        TAD ZEROCH
        JMS PUTC
        JMP I OCT4

/ ------- Constants -------

SPACE,  040      / ' '
CR,     015      / carriage return
LF,     012      / line feed
ZEROCH, 060      / ASCII '0'
SEVEN,  0007
FOUR,   0004
MINUS1, 7777     / -1 in 12 bits
MINUS8, 7770     / -8 in 12 bits

W,      0        / temp counter for OCT4

        / End of program
        $

