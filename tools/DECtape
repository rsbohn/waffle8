#!/usr/bin/env python3
"""
DECtape utility for OS/8 images (.tu56, SIMH format).

Features:
- read: dump a DECtape block (physical 129-word frames by default; OS/8 logical
        256-word blocks with --logical).
- dir:  parse an OS/8 directory segment (block 1 by default) using the layout
        described in pip.pa (4-word header, variable-width entries, DLINK follow).
"""

import argparse
import os
import sys

# Add tools directory to path for tu56 import
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from tu56 import (
    read_physical_block,
    read_os8_block,
    dump_block,
    parse_directory_segment,
    sixbit_pair,
    add_file_to_image,
    list_files,
    create_blank_tu56,
    DEFAULT_OS8_LOGICAL_BLOCKS,
    DEFAULT_OS8_ORIGIN_BLOCK,
)


def print_directory(path: str, start_block: int = 1) -> None:
    seen = set()
    block = start_block
    while block and block not in seen:
        seen.add(block)
        words = read_os8_block(path, block)
        header, entries = parse_directory_segment(words)
        leader = " ".join(f"{w:04o}" for w in header["raw"])
        print(f"Directory block {block} (leader={leader}, count={header['count']:04o}, "
              f"origin={header['origin']:04o}, link={header['link']:04o}, "
              f"free_blocks={header.get('free_blocks', 0):04o})")
        for e in entries:
            label = f"{e['name']}.{e['ext']}" if e["ext"] else e["name"]
            if e["status"] == "free":
                print(f"  [{e['index']:02d}] <FREE>  blocks={e['length_blocks']}")
            elif e["status"] == "tentative":
                print(f"  [{e['index']:02d}] <TENTATIVE> start={e['start_block']:04o} len=0")
            else:
                print(
                    f"  [{e['index']:02d}] {label:<8} start={e['start_block']:04o} "
                    f"len={e['length_blocks']:04o} date(oct)={e['date_raw']:04o}"
                )
        block = header["link"]
        if block == 0:
            break
    if block in seen:
        print(f"Stopped on repeated link to block {block} (possible loop).", file=sys.stderr)


def main() -> None:
    parser = argparse.ArgumentParser(description="DECtape utility for OS/8 images.")
    sub = parser.add_subparsers(dest="cmd")

    p_read = sub.add_parser("read", help="Dump a DECtape block.")
    p_read.add_argument("image")
    p_read.add_argument("block", type=int)
    p_read.add_argument(
        "--logical",
        action="store_true",
        help="Interpret block number as OS/8 logical block (256 words over two frames).",
    )
    p_read.add_argument("-s", "--sixbit", action="store_true", help="Show sixbit pairs instead of octal words.")

    p_dir = sub.add_parser("dir", help="Parse and print an OS/8 directory (block 1 by default).")
    p_dir.add_argument("image")
    p_dir.add_argument("-b", "--block", type=int, default=1, help="Directory block number (default 1).")

    p_add = sub.add_parser("add", help="Add a file to an OS/8 DECtape image.")
    p_add.add_argument("image", help="Path to .tu56 image (must end with .tu56).")
    p_add.add_argument("filename", help="Path to file to add.")
    p_add.add_argument("-n", "--name", help="OS/8 filename (default: derived from input filename).")

    p_cat = sub.add_parser("cat", help="Display contents of a file from an OS/8 DECtape image.")
    p_cat.add_argument("image", help="Path to .tu56 image.")
    p_cat.add_argument("filename", help="OS/8 filename (e.g., HELLO.TX or HELLO).")
    p_cat.add_argument("-a", "--ascii", action="store_true",
                       help="Strip high bit (for ASCII-8 files like .BA).")

    p_zero = sub.add_parser("zero", help="Create a blank OS/8 DECtape image.")
    p_zero.add_argument("image", help="Path to output .tu56 image.")
    p_zero.add_argument("-b", "--blocks", type=int, default=DEFAULT_OS8_LOGICAL_BLOCKS,
                        help=f"Number of OS/8 logical blocks (default {DEFAULT_OS8_LOGICAL_BLOCKS}).")
    p_zero.add_argument("-o", "--origin", type=lambda v: int(v, 0), default=DEFAULT_OS8_ORIGIN_BLOCK,
                        help=f"Origin data block (default octal {DEFAULT_OS8_ORIGIN_BLOCK:o}).")
    p_zero.add_argument("-f", "--force", action="store_true",
                        help="Overwrite existing file if present.")

    args = parser.parse_args()
    if args.cmd == "read":
        if not os.path.isfile(args.image):
            sys.exit(f"File not found: {args.image}")
        reader = read_os8_block if args.logical else read_physical_block
        words = reader(args.image, args.block)
        dump_block(words, sixbit=args.sixbit)
    elif args.cmd == "dir":
        if not os.path.isfile(args.image):
            sys.exit(f"File not found: {args.image}")
        print_directory(args.image, start_block=args.block)
    elif args.cmd == "add":
        # Validate image path
        if not args.image.endswith(".tu56"):
            sys.exit("Error: Image file must end with '.tu56'.")
        if not os.path.isfile(args.image):
            sys.exit(f"File not found: {args.image}")
        if not os.path.isfile(args.filename):
            sys.exit(f"File not found: {args.filename}")

        # Read file data
        with open(args.filename, "rb") as f:
            data = f.read()

        # Determine OS/8 filename and extension
        if args.name:
            os8_name = args.name
        else:
            os8_name = os.path.basename(args.filename)

        # Split into name.ext (OS/8: 6 char name, 2 char ext)
        if "." in os8_name:
            name_part, ext_part = os8_name.rsplit(".", 1)
        else:
            name_part, ext_part = os8_name, ""
        name_part = name_part[:6].upper()
        ext_part = ext_part[:2].upper()

        try:
            blocks = add_file_to_image(args.image, name_part, ext_part, data)
            print(f"Added {name_part}.{ext_part} ({len(data)} bytes, {blocks} blocks) to {args.image}")
        except ValueError as e:
            sys.exit(f"Error: {e}")
    elif args.cmd == "cat":
        if not os.path.isfile(args.image):
            sys.exit(f"File not found: {args.image}")

        # Parse requested filename
        req_name = args.filename.upper()
        if "." in req_name:
            name_part, ext_part = req_name.rsplit(".", 1)
        else:
            name_part, ext_part = req_name, ""
        name_part = name_part[:6]
        ext_part = ext_part[:2]

        # Find the file in the directory
        found = None
        fallback = None  # For matching name only when no extension specified
        for entry in list_files(args.image):
            entry_name = entry["name"].rstrip()
            entry_ext = entry["ext"].rstrip()
            if entry_name == name_part and entry_ext == ext_part:
                found = entry
                break
            # Track first name-only match as fallback when no extension specified
            if ext_part == "" and entry_name == name_part and fallback is None:
                fallback = entry

        if not found:
            found = fallback  # Use fallback if no exact match

        if not found:
            sys.exit(f"File not found in image: {args.filename}")

        # Read and output file contents
        start_block = found["start_block"]
        num_blocks = found["length_blocks"]
        mask = 0o177 if args.ascii else 0o377  # Strip high bit for ASCII-8
        for blk in range(num_blocks):
            words = read_os8_block(args.image, start_block + blk)
            for w in words:
                ch = w & mask
                if ch == 0:
                    continue  # skip nulls
                sys.stdout.write(chr(ch))
    elif args.cmd == "zero":
        try:
            create_blank_tu56(args.image, logical_blocks=args.blocks, origin_block=args.origin, force=args.force)
        except FileExistsError as e:
            sys.exit(str(e))
        except ValueError as e:
            sys.exit(f"Error: {e}")
        total_phys = args.blocks * 2
        print(f"Created {args.image} ({args.blocks} logical blocks, {total_phys} physical frames) with empty directory at block 1.")
    else:
        parser.print_help()
        sys.exit(2)


if __name__ == "__main__":
    main()
